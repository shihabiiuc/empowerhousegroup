---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Thank You - Empowerhouse Group"
  description="Empower the way you work, live & play."
>
  <div class="ty-page">
    <!-- Background layers -->
    <div class="ty-bg-base"></div>
    <div class="ty-bg-glow-core"></div>
    <div class="ty-bg-glow-ring"></div>
    <div class="ty-bg-grid"></div>
    <div class="ty-bg-vignette"></div>

    <!-- Floating orbs -->
    <div class="ty-orb ty-orb-1"></div>
    <div class="ty-orb ty-orb-2"></div>
    <div class="ty-orb ty-orb-3"></div>

    <!-- Signal rings -->
    <div class="ty-rings" aria-hidden="true">
      <div class="ty-ring ty-ring-1"></div>
      <div class="ty-ring ty-ring-2"></div>
      <div class="ty-ring ty-ring-3"></div>
    </div>

    <!-- Main content -->
    <main class="ty-content" role="main">
      <!-- Animated checkmark -->
      <div class="ty-check-wrap" aria-hidden="true">
        <div class="ty-check-outer-ring"></div>
        <div class="ty-check-inner-ring"></div>
        <div class="ty-check-circle">
          <svg
            class="ty-check-svg"
            width="36"
            height="36"
            viewBox="0 0 36 36"
            fill="none"
            aria-hidden="true"
          >
            <path
              class="ty-check-path"
              d="M8 18l7 7 13-13"
              stroke="var(--bg-primary)"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>

      <!-- Kicker -->
      <div class="ty-kicker">
        <span class="ty-kicker-dot"></span>
        The BioCode System<sup>®</sup>
        <span class="ty-kicker-dot"></span>
      </div>

      <!-- Heading -->
      <h1 class="ty-heading">
        <span class="ty-heading-main">Message</span>
        <span class="ty-heading-accent">Received.</span>
      </h1>

      <!-- Divider row -->
      <div class="ty-divider" aria-hidden="true">
        <span class="ty-divider-line"></span>
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
          <circle cx="5" cy="5" r="2.5" fill="var(--accent)" opacity="0.8"
          ></circle>
          <circle
            cx="5"
            cy="5"
            r="4.5"
            stroke="var(--accent)"
            stroke-opacity="0.25"
            stroke-width="1"></circle>
        </svg>
        <span class="ty-divider-line ty-divider-line--rev"></span>
      </div>

      <!-- Body message -->
      <p class="ty-body">
        Thank you for reaching out. Dr. Jill has received your message and will
        get back to you personally — typically within 24 hours.
      </p>

      <p class="ty-body ty-body--sub">
        In the meantime, remember: every strong journey starts with a single
        step. <em>You've already taken yours.</em>
      </p>

      <!-- Action buttons -->
      <div class="ty-actions">
        <a href="/" class="ty-btn ty-btn--primary">
          <span class="ty-btn-bg"></span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 18 18"
            fill="none"
            aria-hidden="true"
            class="ty-btn-icon ty-btn-icon--left"
          >
            <path
              d="M15 9H3M8 4L3 9l5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span class="ty-btn-label">Back to Home</span>
        </a>

        <a href="/self-assessment" class="ty-btn ty-btn--ghost">
          <span class="ty-btn-label">Take the quiz</span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 18 18"
            fill="none"
            aria-hidden="true"
            class="ty-btn-icon"
          >
            <path
              d="M3 9h12M10 4l5 5-5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <!-- Bottom ornament -->
      <div class="ty-ornament" aria-hidden="true">
        <span class="ty-ornament-line"></span>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <circle cx="7" cy="7" r="3" fill="var(--accent)"></circle>
          <circle
            cx="7"
            cy="7"
            r="6"
            stroke="var(--accent)"
            stroke-opacity="0.3"
            stroke-width="1"></circle>
        </svg>
        <span class="ty-ornament-line ty-ornament-line--rev"></span>
      </div>
    </main>
  </div>
  <style>
    /* ══════════════════════════════════════════
     Page shell — full viewport centered
  ══════════════════════════════════════════ */
    .ty-page {
      position: relative;
      min-height: 100svh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      isolation: isolate;
    }

    /* ══════════════════════════════════════════
     Background — same layered system
  ══════════════════════════════════════════ */
    .ty-bg-base {
      position: absolute;
      inset: 0;
      background: var(--bg-primary);
      z-index: 0;
    }

    /* Warm violet-to-green glow — bridging contact → thank you */
    .ty-bg-glow-core {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: radial-gradient(
        ellipse 58% 46% at 50% 52%,
        rgba(62, 232, 164, 0.11) 0%,
        rgba(167, 139, 250, 0.06) 42%,
        transparent 68%
      );
    }

    .ty-bg-glow-ring {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: radial-gradient(
        ellipse 85% 65% at 50% 56%,
        rgba(62, 232, 164, 0.04) 0%,
        transparent 65%
      );
    }

    .ty-bg-grid {
      position: absolute;
      inset: 0;
      z-index: 2;
      background-image: radial-gradient(
        circle,
        rgba(255, 255, 255, 0.05) 1px,
        transparent 1px
      );
      background-size: 36px 36px;
      -webkit-mask-image: radial-gradient(
        ellipse 80% 80% at 50% 50%,
        black 30%,
        transparent 100%
      );
      mask-image: radial-gradient(
        ellipse 80% 80% at 50% 50%,
        black 30%,
        transparent 100%
      );
    }

    .ty-bg-vignette {
      position: absolute;
      inset: 0;
      z-index: 3;
      background: radial-gradient(
        ellipse 100% 100% at 50% 50%,
        transparent 40%,
        rgba(8, 12, 20, 0.72) 100%
      );
      pointer-events: none;
    }

    /* ══════════════════════════════════════════
     Floating orbs
  ══════════════════════════════════════════ */
    .ty-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(65px);
      pointer-events: none;
      z-index: 2;
      opacity: 0;
      animation: ty-orb-drift 22s ease-in-out infinite;
    }

    .ty-orb-1 {
      width: 300px;
      height: 300px;
      top: 10%;
      left: 5%;
      background: radial-gradient(
        circle,
        rgba(62, 232, 164, 0.12),
        transparent 70%
      );
      animation-duration: 24s;
    }
    .ty-orb-2 {
      width: 240px;
      height: 240px;
      bottom: 12%;
      right: 6%;
      background: radial-gradient(
        circle,
        rgba(167, 139, 250, 0.11),
        transparent 70%
      );
      animation-duration: 20s;
      animation-delay: -9s;
    }
    .ty-orb-3 {
      width: 160px;
      height: 160px;
      top: 55%;
      left: 65%;
      background: radial-gradient(
        circle,
        rgba(0, 153, 255, 0.08),
        transparent 70%
      );
      animation-duration: 17s;
      animation-delay: -15s;
    }

    @keyframes ty-orb-drift {
      0% {
        opacity: 0;
        transform: translate(0, 0) scale(1);
      }
      15% {
        opacity: 1;
      }
      50% {
        transform: translate(-22px, 18px) scale(1.06);
      }
      85% {
        opacity: 1;
      }
      100% {
        opacity: 0;
        transform: translate(0, 0) scale(1);
      }
    }

    /* ══════════════════════════════════════════
     Signal rings — green (confirmation)
  ══════════════════════════════════════════ */
    .ty-rings {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }

    .ty-ring {
      position: absolute;
      border-radius: 50%;
      border: 1px solid rgba(62, 232, 164, 0.2);
      opacity: 0;
      animation: ty-ring-expand 7s ease-out infinite;
    }

    .ty-ring-1 {
      width: 300px;
      height: 300px;
      animation-delay: 0s;
    }
    .ty-ring-2 {
      width: 300px;
      height: 300px;
      animation-delay: 2.3s;
    }
    .ty-ring-3 {
      width: 300px;
      height: 300px;
      animation-delay: 4.6s;
    }

    @keyframes ty-ring-expand {
      0% {
        transform: scale(0.4);
        opacity: 0.6;
        border-color: rgba(62, 232, 164, 0.3);
      }
      100% {
        transform: scale(3.5);
        opacity: 0;
        border-color: rgba(62, 232, 164, 0);
      }
    }

    /* ══════════════════════════════════════════
     Main content
  ══════════════════════════════════════════ */
    .ty-content {
      position: relative;
      z-index: 10;
      max-width: 680px;
      padding: 4rem 2rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.8rem;
    }

    /* ── Checkmark animation ── */
    .ty-check-wrap {
      position: relative;
      width: 88px;
      height: 88px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      opacity: 0;
      animation: ty-fade-in 0.6s ease 0.1s forwards;
    }

    /* Outer pulsing ring */
    .ty-check-outer-ring {
      position: absolute;
      inset: -10px;
      border-radius: 50%;
      border: 1px solid rgba(62, 232, 164, 0.2);
      animation: ty-check-pulse 2.8s ease-in-out 0.8s infinite;
    }

    /* Inner soft ring */
    .ty-check-inner-ring {
      position: absolute;
      inset: -3px;
      border-radius: 50%;
      border: 1px solid rgba(62, 232, 164, 0.18);
      animation: ty-check-pulse 2.8s ease-in-out 1.4s infinite;
    }

    @keyframes ty-check-pulse {
      0%,
      100% {
        transform: scale(1);
        opacity: 0.6;
      }
      50% {
        transform: scale(1.08);
        opacity: 0.2;
      }
    }

    /* Circle fill */
    .ty-check-circle {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent) 0%, #38bdf8 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow:
        0 0 0 1px rgba(62, 232, 164, 0.3),
        0 12px 40px rgba(62, 232, 164, 0.28);
      animation: ty-circle-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s both;
    }

    @keyframes ty-circle-pop {
      from {
        transform: scale(0.5);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }

    /* Check path draw */
    .ty-check-path {
      stroke-dasharray: 40;
      stroke-dashoffset: 40;
      animation: ty-draw-check 0.45s ease-out 0.75s forwards;
    }

    @keyframes ty-draw-check {
      to {
        stroke-dashoffset: 0;
      }
    }

    /* ── Kicker ── */
    .ty-kicker {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-family: var(--font-mono);
      font-size: 0.63rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent);
      opacity: 0;
      animation: ty-fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.5s forwards;
    }

    .ty-kicker sup {
      font-size: 0.7em;
    }

    .ty-kicker-dot {
      display: inline-block;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--accent);
      opacity: 0.6;
    }

    /* ── Heading ── */
    .ty-heading {
      font-family: "Cormorant Garamond", Georgia, serif;
      font-size: clamp(3.8rem, 10vw, 7.5rem);
      font-weight: 300;
      line-height: 0.95;
      letter-spacing: -0.02em;
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.1em;
      opacity: 0;
      animation: ty-fade-up 1s cubic-bezier(0.22, 1, 0.36, 1) 0.65s forwards;
    }

    .ty-heading-main {
      color: var(--footer-head);
    }

    .ty-heading-accent {
      font-style: italic;
      background: linear-gradient(
        120deg,
        var(--accent) 0%,
        #38bdf8 55%,
        var(--footer-head) 100%
      );
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 24px rgba(62, 232, 164, 0.22));
    }

    /* ── Divider ── */
    .ty-divider {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      justify-content: center;
      opacity: 0;
      animation: ty-fade-in 0.8s ease 0.85s forwards;
    }

    .ty-divider-line {
      flex: 1;
      max-width: 100px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(62, 232, 164, 0.35));
    }
    .ty-divider-line--rev {
      background: linear-gradient(
        270deg,
        transparent,
        rgba(62, 232, 164, 0.35)
      );
    }

    /* ── Body ── */
    .ty-body {
      font-family: "Lora", Georgia, serif;
      font-size: clamp(1rem, 2vw, 1.15rem);
      line-height: 1.88;
      color: var(--text-muted-light);
      max-width: 520px;
      margin: 0;
      opacity: 0;
      animation: ty-fade-up 1s cubic-bezier(0.22, 1, 0.36, 1) 0.9s forwards;
    }

    .ty-body--sub {
      color: var(--muted);
      font-size: clamp(0.92rem, 1.7vw, 1.02rem);
      animation-delay: 1.05s;
    }

    .ty-body--sub em {
      font-style: italic;
      color: var(--text-muted-light);
    }

    /* ── Action buttons ── */
    .ty-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
      opacity: 0;
      animation: ty-fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) 1.2s forwards;
    }

    .ty-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.88rem 1.8rem;
      border-radius: 50px;
      text-decoration: none;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      font-weight: 600;
      overflow: hidden;
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
    }

    /* Primary — green→blue gradient fill */
    .ty-btn--primary {
      color: var(--bg-primary);
      box-shadow:
        0 4px 24px rgba(62, 232, 164, 0.28),
        0 0 0 1px rgba(62, 232, 164, 0.45);
    }

    .ty-btn-bg {
      position: absolute;
      inset: 0;
      background: linear-gradient(120deg, var(--accent) 0%, #38bdf8 100%);
      z-index: 0;
    }

    .ty-btn-label,
    .ty-btn-icon {
      position: relative;
      z-index: 1;
    }

    .ty-btn-icon--left {
      flex-shrink: 0;
    }

    .ty-btn--primary:hover {
      transform: translateY(-2px);
      box-shadow:
        0 8px 36px rgba(62, 232, 164, 0.38),
        0 0 0 1px rgba(62, 232, 164, 0.55);
    }

    /* Ghost — outlined */
    .ty-btn--ghost {
      color: var(--text-muted-light);
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(6px);
    }

    .ty-btn--ghost:hover {
      transform: translateY(-2px);
      border-color: rgba(62, 232, 164, 0.3);
      color: var(--footer-head);
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.3);
    }

    .ty-btn--ghost:hover .ty-btn-icon {
      transform: translateX(3px);
      transition: transform 0.2s ease;
    }

    /* ── Bottom ornament ── */
    .ty-ornament {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      opacity: 0;
      animation: ty-fade-in 0.8s ease 1.4s forwards;
    }

    .ty-ornament-line {
      display: block;
      width: 64px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(62, 232, 164, 0.3));
    }
    .ty-ornament-line--rev {
      background: linear-gradient(270deg, transparent, rgba(62, 232, 164, 0.3));
    }

    /* ══════════════════════════════════════════
     Entrance animations
  ══════════════════════════════════════════ */
    @keyframes ty-fade-up {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes ty-fade-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    /* ══════════════════════════════════════════
     Reduced motion
  ══════════════════════════════════════════ */
    @media (prefers-reduced-motion: reduce) {
      .ty-check-circle,
      .ty-check-outer-ring,
      .ty-check-inner-ring,
      .ty-orb,
      .ty-ring,
      .ty-kicker,
      .ty-heading,
      .ty-body,
      .ty-actions,
      .ty-ornament,
      .ty-check-wrap,
      .ty-divider {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
      .ty-check-path {
        stroke-dashoffset: 0;
      }
    }
  </style>
</Layout>
