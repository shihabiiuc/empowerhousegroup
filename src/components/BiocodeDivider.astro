---
// BioCodeDivider.astro
---

<section class="bc-divider">
  <div class="bc-inner">
    <div class="bc-line"></div>
    <div class="bc-text-wrap">
      <span class="bc-eyebrow">The BioCode System</span>
      <p class="bc-headline">
        More than a <em>Mindset</em>
        <span class="sep">·</span>
        It's a <em>Skillset</em>
        <span class="sep">·</span>
        A <em>Code to Live By</em>
      </p>
    </div>
    <div class="bc-line bc-line--right"></div>
  </div>
</section>

<style>
  .bc-divider {
    background: var(--bg-primary);
    padding: 64px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .bc-divider::before,
  .bc-divider::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
  }
  .bc-divider::before {
    top: 0;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    opacity: 0.4;
  }
  .bc-divider::after {
    bottom: 0;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    opacity: 0.4;
  }

  .bc-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    max-width: 900px;
    width: 100%;
  }

  .bc-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201, 151, 58, 0.35));
  }
  .bc-line--right {
    background: linear-gradient(90deg, rgba(201, 151, 58, 0.35), transparent);
  }

  .bc-text-wrap {
    text-align: center;
    flex-shrink: 0;
  }

  .bc-eyebrow {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
    opacity: 0.85;
  }

  .bc-headline {
    font-weight: 300;
    font-size: clamp(22px, 3.2vw, 38px);
    line-height: 1.2;
    color: var(--cream);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .bc-headline em {
    font-weight: 600;
    color: var(--gold-light);
    font-style: italic;
  }

  .bc-headline .sep {
    display: inline-block;
    margin: 0 10px;
    color: var(--gold);
    opacity: 0.5;
    font-style: normal;
  }
</style>
