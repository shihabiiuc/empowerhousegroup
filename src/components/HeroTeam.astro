---
// HeroTeam.astro
---

<section class="th-hero">
  <div class="th-bg-grid"></div>
  <div class="th-bg-glow-left"></div>
  <div class="th-bg-glow-right"></div>

  <div class="th-corner th-corner--tl"></div>
  <div class="th-corner th-corner--tr"></div>
  <div class="th-corner th-corner--bl"></div>
  <div class="th-corner th-corner--br"></div>

  <div class="th-inner">
    <div class="th-label">
      <span class="th-label-line"></span>
      The People Behind The System
      <span class="th-label-line"></span>
    </div>

    <span class="th-open-mark" aria-hidden="true">"</span>

    <blockquote class="th-quote">
      We help people build the <strong>inner strength</strong><br />
      to dream big and back it up with <strong>meaningful actions</strong> to<br
      />
      create <strong>real life results</strong> that stick.
    </blockquote>

    <div class="th-attr-wrap">
      <span class="th-attr-line"></span>
      <span class="th-attr">Dr. Jill</span>
      <span class="th-attr-line"></span>
    </div>
  </div>
</section>

<style>
  .th-hero {
    min-height: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary);
    padding: 90px 32px 80px;
    position: relative;
    overflow: hidden;
  }

  .th-bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(201, 151, 58, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 151, 58, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 30%,
      transparent 100%
    );
  }

  .th-bg-glow-left {
    position: absolute;
    top: 0;
    left: -10%;
    width: 55%;
    height: 100%;
    background: radial-gradient(
      ellipse at 20% 50%,
      rgba(62, 232, 164, 0.05) 0%,
      transparent 65%
    );
    pointer-events: none;
  }
  .th-bg-glow-right {
    position: absolute;
    top: 0;
    right: -10%;
    width: 55%;
    height: 100%;
    background: radial-gradient(
      ellipse at 80% 50%,
      rgba(201, 151, 58, 0.06) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  .th-hero::before,
  .th-hero::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
  }
  .th-hero::before {
    top: 0;
    background: linear-gradient(
      90deg,
      transparent 5%,
      rgba(201, 151, 58, 0.35) 50%,
      transparent 95%
    );
  }
  .th-hero::after {
    bottom: 0;
    background: linear-gradient(
      90deg,
      transparent 5%,
      rgba(201, 151, 58, 0.2) 50%,
      transparent 95%
    );
  }

  /* Corner brackets */
  .th-corner {
    position: absolute;
    width: 28px;
    height: 28px;
    opacity: 0.25;
  }
  .th-corner--tl {
    top: 24px;
    left: 24px;
    border-top: 1px solid var(--gold);
    border-left: 1px solid var(--gold);
  }
  .th-corner--tr {
    top: 24px;
    right: 24px;
    border-top: 1px solid var(--gold);
    border-right: 1px solid var(--gold);
  }
  .th-corner--bl {
    bottom: 24px;
    left: 24px;
    border-bottom: 1px solid var(--gold);
    border-left: 1px solid var(--gold);
  }
  .th-corner--br {
    bottom: 24px;
    right: 24px;
    border-bottom: 1px solid var(--gold);
    border-right: 1px solid var(--gold);
  }

  .th-inner {
    position: relative;
    max-width: 820px;
    width: 100%;
    text-align: center;
  }

  .th-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 40px;
    opacity: 0.85;
  }
  .th-label-line {
    width: 28px;
    height: 1px;
    background: var(--accent);
    opacity: 0.4;
  }

  .th-open-mark {
    display: block;
    font-size: 96px;
    line-height: 0.4;
    color: var(--gold);
    opacity: 0.22;
    margin-bottom: 8px;
    user-select: none;
  }

  .th-quote {
    font-style: italic;
    font-weight: 300;
    font-size: clamp(22px, 3.8vw, 40px);
    line-height: 1.45;
    color: var(--cream);
    letter-spacing: 0.01em;
    margin-bottom: 36px;
  }
  .th-quote strong {
    font-style: italic;
    font-weight: 600;
    color: var(--gold-light);
  }

  .th-attr-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .th-attr-line {
    width: 40px;
    height: 1px;
    background: var(--gold);
    opacity: 0.35;
  }
  .th-attr {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0.75;
  }
</style>
