---
import { Image } from "astro:assets";
import shopContact from "../assets/shop_contact.png";
import shopGetStarted from "../assets/shop_get_started.png";
import shopStories from "../assets/shop_stories.png";

const programs = [
  {
    image: shopContact,
    alt: "Life programs — individuals, couples & families",
    eyebrow: "Program 01",
    heading: "Life",
    tagline: "Be that person",
    sub: "For individuals, couples & families",
    accent: "#00c9a7",
  },
  {
    image: shopGetStarted,
    alt: "Edu & Sport programs — students, athletes and organizations",
    eyebrow: "Program 02",
    heading: "Edu & Sport",
    tagline: "Be that strong",
    sub: "For students, athletes & organizations",
    accent: "#f59e0b",
  },
  {
    image: shopStories,
    alt: "Biz programs — leaders, teams & culture",
    eyebrow: "Program 03",
    heading: "Biz",
    tagline: "Be that leader",
    sub: "For leaders, teams & culture",
    accent: "#e25b8b",
  },
];
---

<section class="programs-section" aria-label="Explore our programs">
  <div class="programs-grid">
    {programs.map((p, i) => (
      <a href="/programs" class="program-card" data-index={i} aria-label={`${p.heading} — ${p.tagline}`}>

        <!-- Background image -->
        <Image
          src={p.image}
          alt={p.alt}
          class="card-bg"
          widths={[600, 900, 1200]}
          sizes="(max-width: 768px) 100vw, 33vw"
        />

        <!-- Layered overlays -->
        <div class="card-overlay card-overlay--dark"></div>
        <div class="card-overlay card-overlay--gradient" style={`--accent: ${p.accent};`}></div>
        <div class="card-overlay card-overlay--vignette"></div>

        <!-- Hover shine sweep -->
        <div class="card-shine"></div>

        <!-- Content -->
        <div class="card-content">
          <span class="card-eyebrow">{p.eyebrow}</span>

          <div class="card-text">
            <h2 class="card-heading" style={`--accent: ${p.accent};`}>
              {p.heading}
            </h2>
            <p class="card-tagline">{p.tagline}</p>
            <div class="card-divider" style={`--accent: ${p.accent};`}></div>
            <p class="card-sub">{p.sub}</p>
          </div>

          <div class="card-cta" style={`--accent: ${p.accent};`}>
            <span class="cta-label">Explore</span>
            <span class="cta-arrow">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8"
                  stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </div>

        <!-- Index number watermark -->
        <span class="card-watermark">{String(i + 1).padStart(2, '0')}</span>

      </a>
    ))}
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Mulish:ital,wght@0,300;0,400;0,600;1,300&display=swap');

  .programs-section {
    width: 100%;
    font-family: 'Mulish', sans-serif;
  }

  /* ── Grid ── */
  .programs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
  }

  /* ── Card ── */
  .program-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 640px;
    overflow: hidden;
    text-decoration: none;
    cursor: pointer;
    isolation: isolate;
  }

  /* ── Background Image ── */
  .card-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.9s ease;
    z-index: 0;
  }

  .program-card:hover .card-bg {
    transform: scale(1.07);
    filter: brightness(0.85);
  }

  /* ── Overlays ── */
  .card-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .card-overlay--dark {
    background: rgba(6, 8, 14, 0.42);
    transition: background 0.5s ease;
  }

  .program-card:hover .card-overlay--dark {
    background: rgba(6, 8, 14, 0.55);
  }

  .card-overlay--gradient {
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--accent) 55%, black) 0%,
      transparent 55%
    );
    opacity: 0.9;
    transition: opacity 0.5s ease;
  }

  .program-card:hover .card-overlay--gradient {
    opacity: 1;
  }

  .card-overlay--vignette {
    background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.5) 100%);
  }

  /* ── Shine sweep on hover ── */
  .card-shine {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgba(255,255,255,0.07) 50%,
      transparent 65%
    );
    transform: translateX(-100%);
    transition: transform 0s;
    pointer-events: none;
  }

  .program-card:hover .card-shine {
    transform: translateX(100%);
    transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ── Vertical separator ── */
  .program-card:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    right: 0;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(255,255,255,0.15) 30%,
      rgba(255,255,255,0.15) 70%,
      transparent 100%
    );
    z-index: 10;
  }

  /* ── Content ── */
  .card-content {
    position: relative;
    z-index: 5;
    padding: 48px 44px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Eyebrow */
  .card-eyebrow {
    display: inline-block;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin-bottom: 20px;
    transition: color 0.3s ease;
  }

  .program-card:hover .card-eyebrow {
    color: rgba(255,255,255,0.75);
  }

  /* Text block */
  .card-text {
    margin-bottom: 36px;
  }

  .card-heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3.5rem, 5vw, 5.5rem);
    line-height: 0.92;
    color: #fff;
    margin: 0 0 10px;
    letter-spacing: 0.02em;
    transition: color 0.3s ease, text-shadow 0.3s ease;
  }

  .program-card:hover .card-heading {
    color: #fff;
    text-shadow: 0 0 40px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .card-tagline {
    font-size: 1.05rem;
    font-weight: 300;
    font-style: italic;
    color: rgba(255,255,255,0.85);
    margin: 0 0 18px;
    letter-spacing: 0.03em;
    transition: color 0.3s ease;
  }

  .program-card:hover .card-tagline {
    color: #fff;
  }

  .card-divider {
    width: 36px;
    height: 2px;
    background: var(--accent);
    margin-bottom: 14px;
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .program-card:hover .card-divider {
    width: 60px;
  }

  .card-sub {
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    margin: 0;
    transition: color 0.3s ease;
  }

  .program-card:hover .card-sub {
    color: rgba(255,255,255,0.8);
  }

  /* CTA row */
  .card-cta {
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.35s ease 0.05s, transform 0.35s ease 0.05s;
  }

  .program-card:hover .card-cta {
    opacity: 1;
    transform: translateY(0);
  }

  .cta-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .cta-arrow {
    display: flex;
    align-items: center;
    color: var(--accent);
    transition: transform 0.3s ease;
  }

  .program-card:hover .cta-arrow {
    transform: translateX(4px);
  }

  .cta-arrow svg {
    width: 16px;
    height: 16px;
  }

  /* ── Watermark number ── */
  .card-watermark {
    position: absolute;
    top: 36px;
    right: 36px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 6rem;
    line-height: 1;
    color: rgba(255,255,255,0.06);
    z-index: 3;
    letter-spacing: 0.05em;
    user-select: none;
    pointer-events: none;
    transition: color 0.4s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .program-card:hover .card-watermark {
    color: rgba(255,255,255,0.1);
    transform: scale(1.1) translateY(-4px);
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .programs-grid {
      grid-template-columns: 1fr;
    }

    .program-card {
      min-height: 480px;
    }

    .program-card:not(:last-child)::after {
      top: auto;
      left: 0; right: 0;
      bottom: 0;
      width: 100%;
      height: 1px;
      background: linear-gradient(
        to right,
        transparent 0%,
        rgba(255,255,255,0.15) 30%,
        rgba(255,255,255,0.15) 70%,
        transparent 100%
      );
    }

    .card-content {
      padding: 36px 32px;
    }

    .card-cta {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 480px) {
    .program-card { min-height: 400px; }
    .card-content { padding: 28px 24px; }
    .card-watermark { font-size: 4rem; top: 20px; right: 20px; }
  }
</style>