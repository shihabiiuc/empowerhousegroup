---
// TestimonialsGrid.astro
// Full testimonials grid for the Testimonials page

const testimonials = [
  {
    quote: "Learning my BioCodes gave me the ability to see through my day to day challenges and helped guide me to effortless solutions.",
    name: "Frank Pavlik",
