    name: "Donna Brooks",
    role: "President",
    company: "Heart & Sol Realty",
    initial: "D",
  },
  {
    quote: "There have absolutely been noticeable shifts in my behavior since our first meeting. Thank you again!",
    name: "David Dorn",
    role: "Project Manager — Governance",
    company: "Assurant Specialty Property",
    initial: "D",
  },
  {
    quote: "Thanks to The BioCodes I can really appreciate the notion that my problems are opportunities for me to grow. I can use my energy properly to keep my life moving forward!",
    name: "K. Butler",
    role: "Clinical Social Worker",
    company: "",
    initial: "K",
  },
  {
    quote: "Owning your power to navigate with freedom through difficult situations is the strongest way to live and to give back to others.",
    name: "Dr. Nari Motahar, M.D.",
    role: "Physician",
    company: "Grady Hospital",
    initial: "N",
  },
  {
    quote: "This program was incredible. It shows we needed more than intelligence, determination and vision to be a strong leader. When the day's smaller, unexpected challenges get in our way… learning how to stay empowered and take it on is the key to success.",
    name: "Mark McKenna",
    role: "Senior Consultant",
    company: "Level Up",
    initial: "M",
    featured: true,
  },
  {
    quote: "The Biocode System is an effective set of tools that have helped me transform into an even stronger and more effective leader. I am able to focus on the facts without taking things personally. I can listen to someone who may be complaining or engaging me in a challenging conversation and I can remain calm and listen to their concerns.",
    name: "James Nowell",
    role: "Compliance Risk Manager",
    company: "Assurant Specialty Property",
    initial: "J",
  },
  {
    quote: "Empowerhouse helped us develop the personal power and resilience to reach new heights more effortlessly.",
    name: "John Stulak",
    role: "President",
    company: "EthoTech Accounting Software",
    initial: "J",
  },
  {
    quote: "This program has not only enabled me to think differently, but behave differently as well. I have learned to assess situations more clearly and apply these practices and mindsets not only to my professional life, but in my personal life as well.",
    name: "Stacey Sears",
    role: "Director, Compliance & Quality Assurance Governance",
    company: "Assurant",
    initial: "S",
  },
  {
    quote: "The BioCode System cuts straight to the heart of what actually works. Learning how to use my everyday challenges as opportunities changed the game completely.",
    name: "Sheryl Covell",
    role: "President",
    company: "Saratoga Event Group",
    initial: "S",
  },
];

// Cycle through a small palette of accent tints for the initials
const tints = [
  "teal", "blue", "violet", "teal", "blue",
  "violet", "teal", "blue", "violet", "teal",
  "blue", "violet", "teal", "blue", "violet",
];
---

<section class="tg-section" aria-label="Client testimonials">

  <!-- Background -->
  <div class="tg-bg-base"></div>
  <div class="tg-bg-glow-top"></div>
  <div class="tg-bg-glow-bot"></div>
  <div class="tg-noise"></div>

  <div class="tg-inner">

    <!-- Section header -->
    <header class="tg-header">
      <div class="tg-eyebrow">
        <span class="tg-eyebrow-bar"></span>
        <span>Worked Outs in the Wild</span>
        <span class="tg-eyebrow-bar tg-eyebrow-bar--rev"></span>
      </div>
      <p class="tg-header-sub">
        Every entry below is a real person who did the inner work.<br />
        Their words, unedited.
      </p>
    </header>

    <!-- Masonry-style grid -->
    <div class="tg-grid">
      {testimonials.map((t, i) => (
        <article
          class={`tg-card${t.featured ? " tg-card--featured" : ""}`}
          aria-label={`Testimonial from ${t.name}`}
        >
          <!-- Corner accents — consistent with other sections -->
          <div class="tg-corner tg-corner--tl"></div>
          <div class="tg-corner tg-corner--br"></div>

          <!-- Decorative quote glyph -->
          <div class="tg-glyph" aria-hidden="true">&ldquo;</div>

          <!-- Quote -->
          <blockquote class="tg-quote">
            {t.quote}
          </blockquote>

          <!-- Attribution -->
          <footer class="tg-attribution">
            <div class={`tg-initial tg-initial--${tints[i]}`} aria-hidden="true">
              {t.initial}
            </div>
            <div class="tg-person">
              <span class="tg-name">{t.name}</span>
              <span class="tg-role">
                {t.role}{t.company ? ` · ${t.company}` : ""}
              </span>
            </div>
          </footer>

        </article>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="tg-cta-wrap">
      <p class="tg-cta-text">
        Ready to write your own story?
      </p>
      <a href="/self-assessment" class="tg-cta-btn">
        <span class="tg-cta-btn-bg"></span>
        <span class="tg-cta-btn-label">Take the quiz to get started</span>
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true" class="tg-cta-arrow">
          <path d="M3 9h12M10 4l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>

</section>

<style>
  /* ══════════════════════════════════════════
     Shell
  ══════════════════════════════════════════ */
  .tg-section {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  /* ══════════════════════════════════════════
     Background
  ══════════════════════════════════════════ */
  .tg-bg-base {
    position: absolute; inset: 0;
    background: var(--bg-primary);
    z-index: 0;
  }

  .tg-bg-glow-top {
    position: absolute; top: 0; left: 50%; translate: -50% 0;
    width: 80%; height: 40%;
    background: radial-gradient(ellipse at 50% 0%, rgba(0,153,255,0.06) 0%, transparent 65%);
    z-index: 1; pointer-events: none;
  }

  .tg-bg-glow-bot {
    position: absolute; bottom: 0; left: 50%; translate: -50% 0;
    width: 70%; height: 35%;
    background: radial-gradient(ellipse at 50% 100%, rgba(62,232,164,0.05) 0%, transparent 65%);
    z-index: 1; pointer-events: none;
  }

  .tg-noise {
    position: absolute; inset: 0; z-index: 2; opacity: 0.022;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  /* ══════════════════════════════════════════
     Inner
  ══════════════════════════════════════════ */
  .tg-inner {
    position: relative; z-index: 10;
    max-width: 1200px;
    margin: 0 auto;
    padding: 7rem 2rem 7rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  /* ══════════════════════════════════════════
     Section header
  ══════════════════════════════════════════ */
  .tg-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }

  .tg-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: "DM Mono", "Fira Mono", ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .tg-eyebrow-bar {
    display: inline-block; width: 36px; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent));
    opacity: 0.55;
  }
  .tg-eyebrow-bar--rev {
    background: linear-gradient(270deg, transparent, var(--accent));
  }

  .tg-header-sub {
    font-family: "Lora", Georgia, serif;
    font-size: clamp(0.95rem, 1.8vw, 1.08rem);
    line-height: 1.8;
    color: var(--muted);
    font-style: italic;
    margin: 0;
  }

  /* ══════════════════════════════════════════
     Masonry grid
     CSS columns — browser handles the flow
  ══════════════════════════════════════════ */
  .tg-grid {
    columns: 3 320px;
    column-gap: 1.4rem;
  }

  @media (max-width: 700px) {
    .tg-grid { columns: 1; }
  }

  /* ══════════════════════════════════════════
     Card
  ══════════════════════════════════════════ */
  .tg-card {
    position: relative;
    break-inside: avoid;
    margin-bottom: 1.4rem;
    padding: 2.2rem 2rem 1.8rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    box-shadow:
      0 12px 40px rgba(0,0,0,0.25),
      inset 0 1px 0 rgba(255,255,255,0.04);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .tg-card:hover {
    transform: translateY(-4px);
    border-color: rgba(62,232,164,0.18);
    box-shadow:
      0 22px 55px rgba(0,0,0,0.35),
      0 0 0 1px rgba(62,232,164,0.1),
      inset 0 1px 0 rgba(255,255,255,0.05);
  }

  /* Featured cards get a slightly more prominent treatment */
  .tg-card--featured {
    background: rgba(62,232,164,0.03);
    border-color: rgba(62,232,164,0.13);
    box-shadow:
      0 16px 50px rgba(0,0,0,0.3),
      0 0 0 1px rgba(62,232,164,0.08),
      inset 0 1px 0 rgba(255,255,255,0.05);
  }

  .tg-card--featured:hover {
    border-color: rgba(62,232,164,0.3);
    box-shadow:
      0 26px 65px rgba(0,0,0,0.4),
      0 0 0 1px rgba(62,232,164,0.2),
      inset 0 1px 0 rgba(255,255,255,0.06);
  }

  /* Corner L-brackets — consistent with all other sections */
  .tg-corner {
    position: absolute;
    width: 14px; height: 14px;
    border-color: rgba(62,232,164,0.25);
    border-style: solid; border-radius: 2px;
  }
  .tg-corner--tl { top: 10px; left: 10px; border-width: 1px 0 0 1px; }
  .tg-corner--br { bottom: 10px; right: 10px; border-width: 0 1px 1px 0; }

  /* Decorative quote glyph — must stay inside card bounds */
  .tg-glyph {
    position: absolute;
    top: 0.5rem; left: 1.2rem;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 4.5rem; line-height: 1;
    color: var(--accent); opacity: 0.12;
    user-select: none; pointer-events: none;
    z-index: 0;
  }

  .tg-card--featured .tg-glyph { opacity: 0.18; }

  /* Quote text — sits above the glyph */
  .tg-quote {
    font-family: "Lora", Georgia, serif;
    font-size: clamp(0.88rem, 1.5vw, 0.97rem);
    line-height: 1.88;
    color: var(--text-muted-light);
    font-style: italic;
    margin: 0;
    padding-top: 1.8rem;
    position: relative;
    z-index: 1;
  }

  .tg-card--featured .tg-quote {
    font-size: clamp(0.93rem, 1.6vw, 1.02rem);
    color: var(--footer-head);
  }

  /* Attribution row */
  .tg-attribution {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  /* Initial circle */
  .tg-initial {
    width: 38px; height: 38px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.1rem; font-weight: 600;
    flex-shrink: 0;
    color: var(--bg-primary);
    box-shadow: 0 0 0 2px rgba(255,255,255,0.08);
  }

  .tg-initial--teal {
    background: linear-gradient(135deg, var(--accent) 0%, #38bdf8 100%);
    box-shadow: 0 0 0 3px rgba(62,232,164,0.18);
  }
  .tg-initial--blue {
    background: linear-gradient(135deg, #38bdf8 0%, var(--blue) 100%);
    box-shadow: 0 0 0 3px rgba(56,189,248,0.18);
  }
  .tg-initial--violet {
    background: linear-gradient(135deg, var(--violet) 0%, #38bdf8 100%);
    box-shadow: 0 0 0 3px rgba(167,139,250,0.18);
  }

  .tg-person {
    display: flex; flex-direction: column; gap: 0.18rem;
    min-width: 0;
  }

  .tg-name {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1rem; font-weight: 600;
    color: var(--footer-head);
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tg-role {
    font-family: "DM Mono", ui-monospace, monospace;
    font-size: 0.55rem; letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.5;
  }

  /* ══════════════════════════════════════════
     Bottom CTA
  ══════════════════════════════════════════ */
  .tg-cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.06);
    text-align: center;
  }

  .tg-cta-text {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-weight: 300;
    font-style: italic;
    color: var(--text-muted-light);
    margin: 0;
  }

  .tg-cta-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.88rem 2.2rem;
    border-radius: 50px;
    text-decoration: none;
    font-family: "DM Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--bg-primary);
    font-weight: 600;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow:
      0 4px 24px rgba(62,232,164,0.28),
      0 0 0 1px rgba(62,232,164,0.45);
  }

  .tg-cta-btn-bg {
    position: absolute; inset: 0;
    background: linear-gradient(120deg, var(--accent) 0%, #38bdf8 100%);
    z-index: 0;
    transition: opacity 0.3s ease;
  }

  .tg-cta-btn-label,
  .tg-cta-arrow {
    position: relative; z-index: 1;
  }

  .tg-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow:
      0 8px 36px rgba(62,232,164,0.38),
      0 0 0 1px rgba(62,232,164,0.55);
  }

  .tg-cta-btn:hover .tg-cta-arrow {
    transform: translateX(3px);
    transition: transform 0.2s ease;
  }

  /* ══════════════════════════════════════════
     Reduced motion
  ══════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .tg-card:hover { transform: none; }
    .tg-cta-btn:hover { transform: none; }
  }
</style>