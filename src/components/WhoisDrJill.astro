---
import { Image } from "astro:assets";
import DrJillFamily from "../assets/dr-jill-family.jpg";
import UnexpectedDiscovery from "../assets/Unexpected-Discovery.jpg";
import bringsmetoyou from "../assets/brings-me-to-you.jpg";
---

<section class="jill-section">
  <!-- ─── ambient background ─── -->
  <div class="jill-bg" aria-hidden="true">
    <div class="jill-blob jill-blob--1"></div>
    <div class="jill-blob jill-blob--2"></div>
    <div class="jill-blob jill-blob--3"></div>
    <div class="jill-grid-overlay"></div>
  </div>

  <!-- ─── vertical story spine ─── -->
  <div class="jill-spine" aria-hidden="true">
    <div class="jill-spine__line"></div>
  </div>

  <div class="jill-inner">
    <!-- ══════════════════════════════════
         BLOCK 1 — Hero intro
    ══════════════════════════════════ -->
    <div class="jill-hero">
      <div class="jill-hero__image-col">
        <div class="jill-hero__frame">
          <div class="jill-hero__frame-border"></div>
          <Image
            src={DrJillFamily}
            alt="Dr. Jill with her family"
            class="jill-hero__img"
            widths={[600, 900]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
          <!-- floating credential badge -->
          <div class="jill-badge">
            <span class="jill-badge__number">30+</span>
            <span class="jill-badge__label">Years<br />of Practice</span>
          </div>
        </div>
      </div>

      <div class="jill-hero__text-col">
        <p class="jill-eyebrow">Meet the founder</p>

        <div class="jill-greeting">
          <span class="jill-greeting__hey">Hey!</span>
          <h1 class="jill-greeting__name">I'm Dr. Jill</h1>
        </div>

        <p class="jill-hero__roles">
          Holistic Doctor &nbsp;·&nbsp; Founder &nbsp;·&nbsp; Coach
          &nbsp;·&nbsp; Author
        </p>

        <p class="jill-hero__bio">
          An <strong>unshakable optimist</strong> dedicated to helping you become
          the healthiest, strongest version of yourself — through a system born not
          in a lab, but in the crucible of real life.
        </p>

        <div class="jill-hero__divider">
          <span></span>
          <span class="jill-hero__divider-text">Her Story</span>
          <span></span>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════
         BLOCK 2 — Unexpected Discovery (text left, image right)
    ══════════════════════════════════ -->
    <div class="jill-story jill-story--left">
      <div class="jill-story__text">
        <div class="jill-chapter">
          <span class="jill-chapter__marker" aria-hidden="true">01</span>
          <h2 class="jill-chapter__title">
            An Unexpected<br /><em>Discovery…</em>
          </h2>
        </div>

        <p class="jill-story__lead">
          My story of helping people reclaim their health began over three
          decades ago — but it was in <strong>1996</strong> when the unimaginable
          hit our family directly, and this healing journey became deeply personal.
        </p>

        <p class="jill-story__body">
          On Independence Day, my husband Danny — just 35 — was diagnosed with
          life-threatening brain cancer. With no hope from conventional
          treatments, we knew his best chance of survival was taking it into our
          own hands and seeking unconventional strategies.
        </p>

        <p class="jill-story__body">
          What became most obvious, very quickly, was that figuring out how to
          <em>stay strong and healthy</em> during a time of utter stress and personal
          chaos was not optional — it was mandatory.
        </p>

        <blockquote class="jill-pullquote">
          "The BioCode System was literally born out of the desire to help my
          husband navigate life's most brutal challenge."
        </blockquote>

        <p class="jill-story__body">
          Little did I know that what I was about to discover was not only here
          to help save my husband's life — but to benefit so many others as
          well.
        </p>

        <div class="jill-callout jill-callout--good">
          <span class="jill-callout__icon" aria-hidden="true">❤</span>
          <p>The good news is — <strong>Danny is alive and well.</strong></p>
        </div>
      </div>

      <div class="jill-story__visual">
        <div class="jill-photo-stack">
          <div class="jill-photo-stack__frame">
            <Image
              src={UnexpectedDiscovery}
              alt="The unexpected discovery moment"
              class="jill-story__img"
              widths={[500, 800]}
              sizes="(max-width: 768px) 100vw, 45vw"
            />
          </div>
          <div class="jill-photo-stack__label">
            <span>The Big Aha Moment</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════
         BLOCK 3 — Which brings me to you (image left, text right)
    ══════════════════════════════════ -->
    <div class="jill-story jill-story--right">
      <div class="jill-story__visual">
        <div class="jill-photo-stack jill-photo-stack--flip">
          <div class="jill-photo-stack__frame">
            <Image
              src={bringsmetoyou}
              alt="Dr. Jill connecting with people"
              class="jill-story__img"
              widths={[500, 800]}
              sizes="(max-width: 768px) 100vw, 45vw"
            />
          </div>
          <div class="jill-photo-stack__label jill-photo-stack__label--right">
            <span>Which Brings Me To You</span>
          </div>
        </div>
      </div>

      <div class="jill-story__text">
        <div class="jill-chapter">
          <span class="jill-chapter__marker" aria-hidden="true">02</span>
          <h2 class="jill-chapter__title">
            When I Returned<br /><em>to My Practice…</em>
          </h2>
        </div>

        <p class="jill-story__lead">
          The most eye-opening realization hit me: it wasn't
          <em>life's big problems</em> that were taking people down as much as the
          <strong>stress of everyday life.</strong>
        </p>

        <p class="jill-story__body">
          Regardless of the problem — health, relationships, work, parenting —
          there was a universal missing skill set:
        </p>

        <div class="jill-missing-skill">
          <span class="jill-missing-skill__ellipsis">…</span>
          <p>
            how to <strong>strengthen themselves first</strong> to deal with whatever
            they were facing.
          </p>
        </div>

        <div class="jill-chapter jill-chapter--accent">
          <h3 class="jill-chapter__sub">Which Brings Me To <em>You</em></h3>
        </div>

        <p class="jill-story__body">
          It was then that I knew — this life-strengthening system was needed
          for <strong>everyone</strong>, all ages, all stages. The BioCode
          System is now being used to help individuals, families, schools,
          athletic programs around the globe — as well as executives, managers
          and employees in some of the world's most recognised companies.
        </p>

        <!-- sign-off -->
        <div class="jill-signoff">
          <p class="jill-signoff__line">Let's change lives together,</p>
          <p class="jill-signoff__name">Dr. Jill</p>
          <div class="jill-signoff__rule"></div>
          <p class="jill-signoff__title">Founder, The BioCode System®</p>
        </div>
      </div>
    </div>
  </div><!-- /.jill-inner -->
</section>

<style>
  /* ════════════════════════════════════════
     SECTION SHELL
  ════════════════════════════════════════ */
  .jill-section {
    position: relative;
    width: 100%;
    padding: 7rem 1.5rem 8rem;
    overflow: hidden;
    isolation: isolate;
    contain: layout;
  }

  .jill-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 8rem;
  }

  /* ════════════════════════════════════════
     AMBIENT BACKGROUND
  ════════════════════════════════════════ */
  .jill-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .jill-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(130px);
  }
  .jill-blob--1 {
    width: 700px;
    height: 700px;
    background: var(--teal);
    opacity: 0.07;
    top: -200px;
    left: -300px;
    animation: jb1 20s ease-in-out infinite;
  }
  .jill-blob--2 {
    width: 500px;
    height: 500px;
    background: var(--gold);
    opacity: 0.08;
    top: 40%;
    right: -200px;
    animation: jb2 25s ease-in-out infinite;
  }
  .jill-blob--3 {
    width: 600px;
    height: 600px;
    background: var(--rust);
    opacity: 0.06;
    bottom: 5%;
    left: 20%;
    animation: jb3 30s ease-in-out infinite;
  }

  @keyframes jb1 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(60px, 40px);
    }
  }
  @keyframes jb2 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-50px, -30px);
    }
  }
  @keyframes jb3 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(30px, -50px);
    }
  }

  .jill-grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
    background-size: 80px 80px;
  }

  /* ════════════════════════════════════════
     VERTICAL SPINE
  ════════════════════════════════════════ */
  .jill-spine {
    position: absolute;
    left: 50%;
    top: 14rem;
    bottom: 8rem;
    width: 1px;
    transform: translateX(-50%);
    z-index: 0;
    pointer-events: none;
  }
  .jill-spine__line {
    width: 1px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(62, 232, 164, 0.15) 10%,
      rgba(62, 232, 164, 0.15) 90%,
      transparent
    );
  }

  /* ════════════════════════════════════════
     HERO BLOCK
  ════════════════════════════════════════ */
  .jill-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  /* image column */
  .jill-hero__frame {
    position: relative;
  }
  .jill-hero__frame-border {
    position: absolute;
    inset: -12px -12px 12px 12px;
    border: 1px solid rgba(62, 232, 164, 0.2);
    border-radius: 3px;
    pointer-events: none;
    z-index: 0;
  }
  .jill-hero__img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 560px;
    object-fit: cover;
    object-position: top center;
    border-radius: 2px;
    display: block;
    filter: brightness(0.92) saturate(0.9);
  }

  /* floating badge */
  .jill-badge {
    position: absolute;
    z-index: 2;
    bottom: -1.5rem;
    right: -1.5rem;
    background: var(--bg-primary, #0b1120);
    border: 1px solid rgba(201, 151, 58, 0.3);
    border-radius: 2px;
    padding: 1rem 1.25rem;
    text-align: center;
    backdrop-filter: blur(8px);
  }
  .jill-badge__number {
    display: block;
    font-family: var(--font-display, "Cormorant Garamond", serif);
    font-size: 2.2rem;
    font-weight: 600;
    line-height: 1;
    color: var(--gold-light, #e8c47a);
  }
  .jill-badge__label {
    display: block;
    font-family: var(--font-ui, "Barlow Condensed", sans-serif);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted, #7a8fa6);
    margin-top: 0.3rem;
  }

  /* text column */
  .jill-eyebrow {
    font-family: var(--font-ui, "Barlow Condensed", sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent, #3ee8a4);
    margin-bottom: 1.5rem;
  }

  .jill-greeting {
    margin-bottom: 0.5rem;
  }
  .jill-greeting__hey {
    display: block;
    font-family: var(--font-display, "Cormorant Garamond", serif);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 300;
    font-style: italic;
    color: var(--muted, #7a8fa6);
    line-height: 1;
    margin-bottom: 0.1rem;
  }
  .jill-greeting__name {
    font-family: var(--font-display, "Cormorant Garamond", serif);
    font-size: clamp(3rem, 5.5vw, 5rem);
    font-weight: 600;
    line-height: 0.95;
    color: #fff;
    letter-spacing: -0.01em;
    margin-bottom: 1.2rem;
  }

  .jill-hero__roles {
    font-family: var(--font-ui, "Barlow Condensed", sans-serif);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.25);
    margin-bottom: 2rem;
  }

  .jill-hero__bio {
    font-family: var(--font-body, "Barlow", sans-serif);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.8;
    color: var(--muted, #7a8fa6);
    margin-bottom: 2.5rem;
  }
  .jill-hero__bio strong {
    color: var(--text, #e2e8f0);
    font-weight: 500;
  }

  .jill-hero__divider {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .jill-hero__divider span:not(.jill-hero__divider-text) {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
  }
  .jill-hero__divider-text {
    font-family: var(--font-ui, "Barlow Condensed", sans-serif);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.2);
  }

  /* ════════════════════════════════════════
     STORY BLOCKS (shared)
  ════════════════════════════════════════ */
  .jill-story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }
  .jill-story--right {
    /* image on left, text on right — swap visual order */
  }
  .jill-story--right .jill-story__visual {
    order: -1;
  }

  /* chapter marker */
  .jill-chapter {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .jill-chapter__marker {
    font-family: var(--font-display, "Cormorant Garamond", serif);
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--accent, #3ee8a4);
    opacity: 0.5;
    line-height: 1.6;
    flex-shrink: 0;
  }
  .jill-chapter__title {
    font-family: var(--font-display, "Cormorant Garamond", serif);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--text, #e2e8f0);
  }
  .jill-chapter__title em {
    font-style: italic;
    color: var(--gold-light, #e8c47a);
  }

  .jill-chapter--accent .jill-chapter__sub {
    font-family: var(--font-display, "Cormorant Garamond", serif);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 300;
    color: var(--text, #e2e8f0);
    border-left: 2px solid var(--accent, #3ee8a4);
    padding-left: 1rem;
    margin: 2.5rem 0 1.5rem;
    line-height: 1.2;
  }
  .jill-chapter--accent .jill-chapter__sub em {
    font-style: italic;
    color: var(--accent, #3ee8a4);
  }

  .jill-story__lead {
    font-family: var(--font-body, "Barlow", sans-serif);
    font-size: 1.12rem;
    font-weight: 400;
    line-height: 1.75;
    color: var(--text, #e2e8f0);
    margin-bottom: 1.5rem;
  }
  .jill-story__lead em {
    font-style: italic;
    color: var(--muted, #7a8fa6);
  }

  .jill-story__body {
    font-family: var(--font-body, "Barlow", sans-serif);
    font-size: 0.97rem;
    font-weight: 300;
    line-height: 1.85;
    color: var(--muted, #7a8fa6);
    margin-bottom: 1.25rem;
  }
  .jill-story__body strong {
    color: var(--text, #e2e8f0);
    font-weight: 500;
  }
  .jill-story__body em {
    font-style: italic;
  }

  /* pull quote */
  .jill-pullquote {
    position: relative;
    margin: 2rem 0;
    padding: 1.5rem 1.75rem 1.5rem 2rem;
    border-left: 3px solid var(--gold, #c9973a);
    background: rgba(201, 151, 58, 0.05);
    border-radius: 0 2px 2px 0;
    font-family: var(--font-display, "Cormorant Garamond", serif);
    font-size: 1.2rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.6;
    color: var(--gold-light, #e8c47a);
  }
  .jill-pullquote::before {
    content: "\201C";
    position: absolute;
    top: -0.5rem;
    left: 1rem;
    font-size: 4rem;
    font-family: var(--font-display, "Cormorant Garamond", serif);
    color: var(--gold, #c9973a);
    opacity: 0.3;
    line-height: 1;
  }

  /* good news callout */
  .jill-callout {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border: 1px solid rgba(62, 232, 164, 0.2);
    border-radius: 2px;
    background: rgba(62, 232, 164, 0.05);
    margin-top: 1.5rem;
  }
  .jill-callout__icon {
    font-size: 1.1rem;
    color: var(--accent, #3ee8a4);
    opacity: 0.7;
    flex-shrink: 0;
  }
  .jill-callout p {
    font-family: var(--font-body, "Barlow", sans-serif);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--muted, #7a8fa6);
  }
  .jill-callout p strong {
    color: var(--accent, #3ee8a4);
    font-weight: 500;
  }

  /* missing skill callout */
  .jill-missing-skill {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 2px;
    margin: 1.5rem 0;
  }
  .jill-missing-skill__ellipsis {
    font-family: var(--font-display, "Cormorant Garamond", serif);
    font-size: 2rem;
    font-style: italic;
    color: var(--warm, #ff6b6b);
    line-height: 1;
    flex-shrink: 0;
    margin-top: -0.3rem;
  }
  .jill-missing-skill p {
    font-family: var(--font-body, "Barlow", sans-serif);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--text, #e2e8f0);
    font-style: italic;
  }
  .jill-missing-skill p strong {
    font-style: normal;
    font-weight: 500;
    color: var(--warm, #ff6b6b);
  }

  /* ════════════════════════════════════════
     PHOTO VISUALS
  ════════════════════════════════════════ */
  .jill-photo-stack {
    position: relative;
    padding-top: 1.5rem;
    padding-right: 1.5rem;
  }
  .jill-photo-stack--flip {
    padding-right: 0;
    padding-left: 1.5rem;
  }
  .jill-photo-stack__frame {
    position: relative;
    z-index: 1;
    border-radius: 2px;
    overflow: hidden;
    /* decorative offset shadow border */
    box-shadow:
      12px 12px 0 rgba(255, 255, 255, 0.04),
      12px 12px 0 1px rgba(255, 255, 255, 0.07);
  }
  .jill-photo-stack--flip .jill-photo-stack__frame {
    box-shadow:
      -12px 12px 0 rgba(255, 255, 255, 0.04),
      -12px 12px 0 1px rgba(255, 255, 255, 0.07);
  }
  .jill-story__img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: center top;
    display: block;
    filter: brightness(0.88) saturate(0.85);
    transition:
      filter 0.5s ease,
      transform 0.6s ease;
  }
  .jill-photo-stack:hover .jill-story__img {
    filter: brightness(0.95) saturate(1);
    transform: scale(1.02);
  }

  /* floating chapter label on photo */
  .jill-photo-stack__label {
    position: absolute;
    top: 0;
    right: 0;
    background: var(--bg-primary, #0b1120);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.5rem 0.9rem;
    z-index: 2;
    border-radius: 1px;
  }
  .jill-photo-stack__label--right {
    right: auto;
    left: 0;
  }
  .jill-photo-stack__label span {
    font-family: var(--font-ui, "Barlow Condensed", sans-serif);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.3);
  }

  /* ════════════════════════════════════════
     SIGN-OFF
  ════════════════════════════════════════ */
  .jill-signoff {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .jill-signoff__line {
    font-family: var(--font-body, "Barlow", sans-serif);
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--muted, #7a8fa6);
    margin-bottom: 0.5rem;
  }
  .jill-signoff__name {
    font-family: var(--font-display, "Cormorant Garamond", serif);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 600;
    font-style: italic;
    color: var(--gold-light, #e8c47a);
    line-height: 1;
    margin-bottom: 1rem;
  }
  .jill-signoff__rule {
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--gold, #c9973a), transparent);
    margin-bottom: 0.75rem;
  }
  .jill-signoff__title {
    font-family: var(--font-ui, "Barlow Condensed", sans-serif);
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.2);
  }

  /* ════════════════════════════════════════
     RESPONSIVE
  ════════════════════════════════════════ */
  @media (max-width: 1024px) {
    .jill-inner {
      gap: 6rem;
    }
    .jill-hero,
    .jill-story {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .jill-hero__img {
      height: 420px;
    }
    .jill-story--right .jill-story__visual {
      order: 0;
    }
    .jill-spine {
      display: none;
    }
    .jill-badge {
      bottom: -1rem;
      right: -0.5rem;
    }
  }

  @media (max-width: 600px) {
    .jill-section {
      padding: 4rem 1rem 5rem;
    }
    .jill-inner {
      gap: 4.5rem;
    }
    .jill-hero__img,
    .jill-story__img {
      height: 300px;
    }
    .jill-photo-stack,
    .jill-photo-stack--flip {
      padding: 0;
    }
    .jill-photo-stack__frame {
      box-shadow: none;
    }
  }

  /* ════════════════════════════════════════
     SCROLL-TRIGGERED ENTRANCE (IntersectionObserver via JS)
  ════════════════════════════════════════ */
  .jill-hero,
  .jill-story,
  .jill-pullquote,
  .jill-callout,
  .jill-missing-skill,
  .jill-signoff {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
  }
  .jill-hero.is-visible,
  .jill-story.is-visible,
  .jill-pullquote.is-visible,
  .jill-callout.is-visible,
  .jill-missing-skill.is-visible,
  .jill-signoff.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function initJillReveal() {
    const revealEls = document.querySelectorAll(
      ".jill-hero, .jill-story, .jill-pullquote, .jill-callout, .jill-missing-skill, .jill-signoff",
    );

    // If elements are already visible (e.g. re-running after VT),
    // reset them so the animation plays again
    revealEls.forEach((el) => {
      el.classList.remove("is-visible");
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add("is-visible");
            }, 80);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );

    revealEls.forEach((el) => observer.observe(el));
  }

  // Runs on full page load AND after every view transition
  document.addEventListener("astro:page-load", initJillReveal);
</script>
