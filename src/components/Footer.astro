---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "The BioCode System", href: "/the-biocode-system" },
  { label: "Team", href: "/team" },
  { label: "Coaching Programs", href: "/coaching-programs" },
  { label: "Contact", href: "/contact" },
];

const resourceLinks = [
  { label: "Free Behavioral Fitness Score", href: "/free-score" },
  { label: "Blog", href: "/blog" },
  { label: "FAQ", href: "/faq" },
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms of Service", href: "/terms" },
];

const socialLinks = [
  {
    label: "Instagram",
    href: "https://instagram.com/biocode",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  },
  {
    label: "Facebook",
    href: "https://facebook.com/biocode",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/company/biocode",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
  {
    label: "YouTube",
    href: "https://youtube.com/@biocode",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>`,
  },
  {
    label: "X / Twitter",
    href: "https://x.com/biocode",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
];
---

<footer id="site-footer">
  <div class="footer-inner">
    <!-- Brand column -->
    <div class="brand-col">
      <a href="/" class="footer-logo">
        <img src="/logo.png" alt="BioCode" />
      </a>
      <p class="tagline">
        Science-backed behavioral coaching to help you become the best version
        of yourself.
      </p>

      <!-- Social icons -->
      <div class="social-row">
        {
          socialLinks.map((s) => (
            <a
              href={s.href}
              class="social-icon"
              aria-label={s.label}
              target="_blank"
              rel="noopener noreferrer"
              set:html={s.icon}
            />
          ))
        }
      </div>
    </div>

    <!-- Quick Links -->
    <div class="link-col">
      <h4>Quick Links</h4>
      <ul>
        {
          quickLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Resources -->
    <div class="link-col">
      <h4>Resources</h4>
      <ul>
        {
          resourceLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- CTA column -->
    <div class="cta-col">
      <h4>Get Started Free</h4>
      <p>
        Take our Behavioral Fitness Score assessment and discover where you
        stand today.
      </p>
      <a href="/free-score" class="cta-btn">Take the Free Assessment →</a>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <span>&copy; {currentYear} BioCode. All rights reserved.</span>
    <div class="bottom-links">
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
      <a href="/sitemap">Sitemap</a>
    </div>
  </div>
</footer>

<style>
  #site-footer {
    background: var(--bg-primary);
    border-top: 1px solid var(--border);
    font-family: var(--font-body);
    margin-top: 5rem;
  }

  /* ── Main grid ── */
  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    gap: 3rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
  }

  /* ── Brand column ── */
  .footer-logo img {
    height: 36px;
    width: auto;
    display: block;
    margin-bottom: 1rem;
  }

  .tagline {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.65;
    max-width: 260px;
    margin-bottom: 1.5rem;
  }

  /* ── Social icons ── */
  .social-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }

  .social-icon:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(62, 232, 164, 0.07);
  }

  /* ── Link columns ── */
  .link-col h4,
  .cta-col h4 {
    color: var(--footer-head);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .link-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .link-col a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .link-col a:hover {
    color: var(--accent);
  }

  /* ── CTA column ── */
  .cta-col p {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .cta-btn {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    background: var(--accent);
    color: #0b1120;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }

  .cta-btn:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  /* ── Bottom bar ── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .bottom-links {
    display: flex;
    gap: 1.5rem;
  }

  .bottom-links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .bottom-links a:hover {
    color: var(--accent);
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
    .brand-col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
