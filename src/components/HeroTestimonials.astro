---
// HeroTestimonials.astro
---

<section class="ht-section" aria-label="Testimonials hero">
  <!-- ── Background layers ── -->
  <div class="ht-bg-base"></div>
  <div class="ht-bg-glow-core"></div>
  <div class="ht-bg-glow-ring"></div>
  <div class="ht-bg-grid"></div>
  <div class="ht-bg-vignette"></div>

  <!-- Floating orbs -->
  <div class="ht-orb ht-orb-1"></div>
  <div class="ht-orb ht-orb-2"></div>
  <div class="ht-orb ht-orb-3"></div>

  <!-- Signal rings -->
  <div class="ht-rings" aria-hidden="true">
    <div class="ht-ring ht-ring-1"></div>
    <div class="ht-ring ht-ring-2"></div>
    <div class="ht-ring ht-ring-3"></div>
  </div>

  <!-- ── Content ── -->
  <div class="ht-content">
    <!-- Eyebrow -->
    <div class="ht-kicker">
      <span class="ht-kicker-dot"></span>
      The BioCode System<sup>®</sup>
      <span class="ht-kicker-dot"></span>
    </div>

    <!-- Heading block -->
    <div class="ht-heading-block">
      <h1 class="ht-heading">
        <span class="ht-heading-main">Testimonials</span>
      </h1>
      <div class="ht-heading-sub-row" aria-label="Real results. Real workouts.">
        <span class="ht-sub-line" aria-hidden="true"></span>
        <p class="ht-heading-sub">
          Real <em class="ht-sub-em">Worked&nbsp;Outs</em>
          <span class="ht-sub-separator" aria-hidden="true">·</span>
          Real Results
        </p>
        <span class="ht-sub-line ht-sub-line--rev" aria-hidden="true"></span>
      </div>
    </div>

    <!-- Body text -->
    <p class="ht-body">
      These aren't passive reviews — they're reports from the field. Every story
      below is someone who showed up, did the inner work, and came out stronger
      on the other side.
    </p>

    <!-- Stat strip -->
    <div class="ht-stats" role="list" aria-label="Impact at a glance">
      <div class="ht-stat" role="listitem">
        <span class="ht-stat-num">1000<span class="ht-stat-plus">+</span></span>
        <span class="ht-stat-label">Lives Strengthened</span>
      </div>
      <div class="ht-stat-divider" aria-hidden="true"></div>
      <div class="ht-stat" role="listitem">
        <span class="ht-stat-num">30<span class="ht-stat-plus">+</span></span>
        <span class="ht-stat-label">Years of Practice</span>
      </div>
      <div class="ht-stat-divider" aria-hidden="true"></div>
      <div class="ht-stat" role="listitem">
        <span class="ht-stat-num">5</span>
        <span class="ht-stat-label">Core BioCodes<sup>®</sup></span>
      </div>
    </div>

    <!-- Bottom ornament -->
    <div class="ht-ornament" aria-hidden="true">
      <span class="ht-ornament-line"></span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <circle cx="7" cy="7" r="3" fill="var(--accent)"></circle>
        <circle
          cx="7"
          cy="7"
          r="6"
          stroke="var(--accent)"
          stroke-opacity="0.3"
          stroke-width="1"></circle>
      </svg>
      <span class="ht-ornament-line ht-ornament-line--rev"></span>
    </div>
  </div>
</section>

<style>
  /* ══════════════════════════════════════════
     Shell
  ══════════════════════════════════════════ */
  .ht-section {
    position: relative;
    min-height: 92svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* ══════════════════════════════════════════
     Background layers — identical system to HeroBiosystem
  ══════════════════════════════════════════ */
  .ht-bg-base {
    position: absolute;
    inset: 0;
    background: var(--bg-primary);
    z-index: 0;
  }

  .ht-bg-glow-core {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      ellipse 60% 45% at 50% 54%,
      rgba(0, 153, 255, 0.1) 0%,
      rgba(62, 232, 164, 0.06) 42%,
      transparent 70%
    );
  }

  .ht-bg-glow-ring {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      ellipse 88% 65% at 50% 58%,
      rgba(62, 232, 164, 0.04) 0%,
      transparent 65%
    );
  }

  .ht-bg-grid {
    position: absolute;
    inset: 0;
    z-index: 2;
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.05) 1px,
      transparent 1px
    );
    background-size: 36px 36px;
    -webkit-mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 30%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 30%,
      transparent 100%
    );
  }

  .ht-bg-vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(
      ellipse 100% 100% at 50% 50%,
      transparent 40%,
      rgba(8, 12, 20, 0.7) 100%
    );
    pointer-events: none;
  }

  /* ══════════════════════════════════════════
     Floating orbs
  ══════════════════════════════════════════ */
  .ht-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    animation: ht-orb-drift 20s ease-in-out infinite;
  }

  .ht-orb-1 {
    width: 300px;
    height: 300px;
    top: 10%;
    right: 6%;
    background: radial-gradient(
      circle,
      rgba(0, 153, 255, 0.13),
      transparent 70%
    );
    animation-duration: 24s;
    animation-delay: 0s;
  }
  .ht-orb-2 {
    width: 240px;
    height: 240px;
    bottom: 14%;
    left: 6%;
    background: radial-gradient(
      circle,
      rgba(62, 232, 164, 0.11),
      transparent 70%
    );
    animation-duration: 20s;
    animation-delay: -9s;
  }
  .ht-orb-3 {
    width: 160px;
    height: 160px;
    top: 52%;
    right: 58%;
    background: radial-gradient(
      circle,
      rgba(167, 139, 250, 0.09),
      transparent 70%
    );
    animation-duration: 18s;
    animation-delay: -15s;
  }

  @keyframes ht-orb-drift {
    0% {
      opacity: 0;
      transform: translate(0, 0) scale(1);
    }
    15% {
      opacity: 1;
    }
    50% {
      transform: translate(-28px, 22px) scale(1.07);
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(0, 0) scale(1);
    }
  }

  /* ══════════════════════════════════════════
     Signal rings
  ══════════════════════════════════════════ */
  .ht-rings {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .ht-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(0, 153, 255, 0.2);
    opacity: 0;
    animation: ht-ring-expand 7s ease-out infinite;
  }

  .ht-ring-1 {
    width: 300px;
    height: 300px;
    animation-delay: 0s;
  }
  .ht-ring-2 {
    width: 300px;
    height: 300px;
    animation-delay: 2.3s;
  }
  .ht-ring-3 {
    width: 300px;
    height: 300px;
    animation-delay: 4.6s;
  }

  @keyframes ht-ring-expand {
    0% {
      transform: scale(0.4);
      opacity: 0.55;
      border-color: rgba(0, 153, 255, 0.28);
    }
    100% {
      transform: scale(3.4);
      opacity: 0;
      border-color: rgba(0, 153, 255, 0);
    }
  }

  /* ══════════════════════════════════════════
     Content
  ══════════════════════════════════════════ */
  .ht-content {
    position: relative;
    z-index: 10;
    max-width: 780px;
    padding: 6rem 2rem 5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  /* Kicker */
  .ht-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.63rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0;
    animation: ht-fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
  }

  .ht-kicker sup {
    font-size: 0.7em;
    color: var(--accent);
  }

  .ht-kicker-dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.6;
  }

  /* Heading block */
  .ht-heading-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    animation: ht-fade-up 1s cubic-bezier(0.22, 1, 0.36, 1) 0.4s forwards;
  }

  .ht-heading {
    font-size: clamp(4.5rem, 13vw, 10rem);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .ht-heading-main {
    display: block;
    background: linear-gradient(
      130deg,
      var(--footer-head) 0%,
      #38bdf8 45%,
      var(--accent) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 32px rgba(0, 153, 255, 0.22));
  }

  /* "Worked Outs" sub-row */
  .ht-heading-sub-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    justify-content: center;
  }

  .ht-sub-line {
    flex: 1;
    max-width: 90px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(56, 189, 248, 0.4));
  }
  .ht-sub-line--rev {
    background: linear-gradient(270deg, transparent, rgba(56, 189, 248, 0.4));
  }

  .ht-heading-sub {
    font-size: clamp(0.7rem, 1.4vw, 0.82rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .ht-sub-em {
    font-style: normal;
    color: var(--accent);
    letter-spacing: 0.18em;
  }

  .ht-sub-separator {
    color: rgba(255, 255, 255, 0.2);
    font-style: normal;
  }

  /* Body */
  .ht-body {
    font-size: clamp(1rem, 2vw, 1.18rem);
    line-height: 1.88;
    color: var(--text-muted-light);
    max-width: 580px;
    margin: 0;
    opacity: 0;
    animation: ht-fade-up 1s cubic-bezier(0.22, 1, 0.36, 1) 0.65s forwards;
  }

  /* ══════════════════════════════════════════
     Stat strip
  ══════════════════════════════════════════ */
  .ht-stats {
    display: flex;
    align-items: center;
    gap: 0;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 50px;
    padding: 1rem 2.5rem;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    animation: ht-fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.9s forwards;
  }

  .ht-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0 2rem;
  }

  .ht-stat-num {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    color: var(--footer-head);
    line-height: 1;
  }

  .ht-stat-plus {
    color: var(--accent);
    font-size: 0.75em;
    vertical-align: super;
  }

  .ht-stat-label {
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .ht-stat-label sup {
    font-size: 0.7em;
    color: var(--accent);
  }

  .ht-stat-divider {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }

  @media (max-width: 500px) {
    .ht-stats {
      padding: 0.9rem 1.2rem;
      border-radius: 16px;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .ht-stat {
      padding: 0 1rem;
    }
    .ht-stat-divider {
      display: none;
    }
  }

  /* ══════════════════════════════════════════
     Bottom ornament
  ══════════════════════════════════════════ */
  .ht-ornament {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    animation: ht-fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) 1.1s forwards;
  }

  .ht-ornament-line {
    display: block;
    width: 64px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(62, 232, 164, 0.35));
  }
  .ht-ornament-line--rev {
    background: linear-gradient(270deg, transparent, rgba(62, 232, 164, 0.35));
  }

  /* ══════════════════════════════════════════
     Entrance animation
  ══════════════════════════════════════════ */
  @keyframes ht-fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ══════════════════════════════════════════
     Reduced motion
  ══════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .ht-orb,
    .ht-ring,
    .ht-kicker,
    .ht-heading-block,
    .ht-body,
    .ht-stats,
    .ht-ornament {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
