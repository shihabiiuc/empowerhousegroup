---
// BiocodeResilience.astro
// Behavioral Agility & Personal Strength Section
---

<section class="biocode-section">
  <!-- Background layers -->
  <div class="bg-grid"></div>
  <div class="bg-orb orb-1"></div>
  <div class="bg-orb orb-2"></div>
  <div class="bg-orb orb-3"></div>

  <div class="container">
    <!-- Header block -->
    <div class="header-block">
      <span class="eyebrow">The System in Number</span>
      <h2 class="heading">
        Behavioral agility increased<br />
        <em>personal strength</em> and resilience.
      </h2>
      <p class="subtext">
        Individuals assessed with The BioCode System® reported a <strong
          >78% improvement</strong
        > in their ability to perform at their best, using stress as a strategy for
        their personal growth. Reports revealed increased sustainable life habits,
        regulation of emotions, management of thoughts and positive behaviors, despite
        the circumstances.
      </p>
    </div>

    <!-- Stats grid -->
    <div class="stats-grid">
      <!-- Stat 1 -->
      <div class="stat-card" data-percent="78">
        <div class="ring-wrap">
          <svg
            class="ring-svg"
            viewBox="0 0 160 160"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#00f5c4"></stop>
                <stop offset="100%" stop-color="#0099ff"></stop>
              </linearGradient>
            </defs>
            <circle class="ring-track" cx="80" cy="80" r="68"></circle>
            <circle
              class="ring-fill"
              cx="80"
              cy="80"
              r="68"
              style="--dash: 427.26; --pct: 0.78;"></circle>
          </svg>
          <div class="ring-center">
            <span class="pct-num" data-target="78">0</span>
            <span class="pct-sym">%</span>
          </div>
        </div>
        <div class="stat-label">
          <strong>Improvement In Personal Strength</strong> And Resilience With The
          Biocode System
        </div>
        <div class="stat-tag">BioCode Users</div>
      </div>

      <!-- Stat 2 -->
      <div class="stat-card stat-card--mid" data-percent="80">
        <div class="ring-wrap">
          <svg
            class="ring-svg"
            viewBox="0 0 160 160"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ff6b6b"></stop>
                <stop offset="100%" stop-color="#ffa94d"></stop>
              </linearGradient>
            </defs>
            <circle class="ring-track" cx="80" cy="80" r="68"></circle>
            <circle
              class="ring-fill ring-fill--warm"
              cx="80"
              cy="80"
              r="68"
              style="--dash: 427.26; --pct: 0.80;"></circle>
          </svg>
          <div class="ring-center">
            <span class="pct-num" data-target="80">0</span>
            <span class="pct-sym">%</span>
          </div>
        </div>
        <div class="stat-label">
          <strong>Of People Feel Stress,</strong> Nearly Half Say They Need Help To
          Manage Stress
        </div>
        <div class="stat-tag stat-tag--warm">
          The American Institute Of Stress
        </div>
      </div>

      <!-- Stat 3 -->
      <div class="stat-card" data-percent="78">
        <div class="ring-wrap">
          <svg
            class="ring-svg"
            viewBox="0 0 160 160"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <linearGradient id="grad3" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#a78bfa"></stop>
                <stop offset="100%" stop-color="#38bdf8"></stop>
              </linearGradient>
            </defs>
            <circle class="ring-track" cx="80" cy="80" r="68"></circle>
            <circle
              class="ring-fill ring-fill--violet"
              cx="80"
              cy="80"
              r="68"
              style="--dash: 427.26; --pct: 0.78;"></circle>
          </svg>
          <div class="ring-center">
            <span class="pct-num" data-target="78">0</span>
            <span class="pct-sym">%</span>
          </div>
        </div>
        <div class="stat-label">
          <strong>Improvement in Personal Strength</strong> for Biocode System Users
        </div>
        <div class="stat-tag stat-tag--violet">BioCode System</div>
      </div>
    </div><!-- /stats-grid -->
  </div><!-- /container -->
</section>

