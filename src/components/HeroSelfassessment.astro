---
// SelfAssessmentHero.astro
---

<section class="sa-hero">
  <!-- ambient bg -->
  <div class="sa-bg" aria-hidden="true">
    <div class="sa-blob sa-blob--1"></div>
    <div class="sa-blob sa-blob--2"></div>
    <div class="sa-blob sa-blob--3"></div>
    <div class="sa-grid"></div>
  </div>

  <!-- animated scan line -->
  <div class="sa-scanline" aria-hidden="true"></div>

  <div class="sa-inner">
    <!-- eyebrow -->
    <div class="sa-eyebrow">
      <span class="sa-eyebrow__dot" aria-hidden="true"></span>
      <span class="sa-eyebrow__label">The BioCode System®</span>
      <span class="sa-eyebrow__dot" aria-hidden="true"></span>
    </div>

    <!-- main heading -->
    <h1 class="sa-heading">
      <span class="sa-heading__line sa-heading__line--1">Self-</span>
      <span class="sa-heading__line sa-heading__line--2">assessment</span>
    </h1>

    <!-- sub-rule -->
    <div class="sa-rule" aria-hidden="true">
      <span class="sa-rule__line"></span>
      <span class="sa-rule__glyph">◆</span>
      <span class="sa-rule__line sa-rule__line--rev"></span>
    </div>

    <!-- descriptor -->
    <p class="sa-descriptor">
      Discover your inner strengths &amp; <em>unlock your potential</em>
    </p>
  </div>

  <!-- bottom fade -->
  <div class="sa-fade" aria-hidden="true"></div>
</section>

<style>
  /* ══════════════════════════
     SHELL
  ══════════════════════════ */
  .sa-hero {
    position: relative;
    width: 100%;
    min-height: clamp(340px, 48vh, 520px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
    contain: layout;
  }

  /* ══════════════════════════
     AMBIENT BG
  ══════════════════════════ */
  .sa-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .sa-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
  }
  .sa-blob--1 {
    width: 560px;
    height: 560px;
    background: var(--teal, #00f5c4);
    opacity: 0.08;
    top: -200px;
    left: -180px;
    animation: sab1 20s ease-in-out infinite;
  }
  .sa-blob--2 {
    width: 420px;
    height: 420px;
    background: var(--gold, #c9973a);
    opacity: 0.09;
    bottom: -160px;
    right: -120px;
    animation: sab2 26s ease-in-out infinite;
  }
  .sa-blob--3 {
    width: 360px;
    height: 360px;
    background: var(--violet, #a78bfa);
    opacity: 0.06;
    top: 20%;
    left: 55%;
    animation: sab3 32s ease-in-out infinite;
  }

  @keyframes sab1 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(40px, 25px);
    }
  }
  @keyframes sab2 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-35px, -30px);
    }
  }
  @keyframes sab3 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-20px, 30px);
    }
  }

  .sa-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(
      ellipse 80% 100% at 50% 50%,
      black 40%,
      transparent 100%
    );
  }

  /* ══════════════════════════
     SCAN LINE
  ══════════════════════════ */
  .sa-scanline {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }
  .sa-scanline::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(62, 232, 164, 0) 20%,
      rgba(62, 232, 164, 0.35) 50%,
      rgba(62, 232, 164, 0) 80%,
      transparent 100%
    );
    top: -2px;
    animation: scan 5s ease-in-out infinite 1.2s;
  }
  @keyframes scan {
    0% {
      top: -2px;
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    95% {
      opacity: 0.6;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  /* ══════════════════════════
     INNER
  ══════════════════════════ */
  .sa-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 4rem 1.5rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* ══════════════════════════
     EYEBROW
  ══════════════════════════ */
  .sa-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
    opacity: 0;
    animation: saFadeUp 0.7s 0.1s ease both;
  }
  .sa-eyebrow__label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent, #3ee8a4);
  }
  .sa-eyebrow__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent, #3ee8a4);
    opacity: 0.5;
  }

  /* ══════════════════════════
     HEADING
  ══════════════════════════ */
  .sa-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.92;
    margin-bottom: 0;
  }

  .sa-heading__line {
    display: block;
    font-weight: 300;
    color: var(--text, #e2e8f0);
    letter-spacing: -0.02em;
    opacity: 0;
  }

  /* "Self-" — smaller, italic, muted */
  .sa-heading__line--1 {
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    font-style: italic;
    color: var(--muted, #7a8fa6);
    letter-spacing: 0.01em;
    animation: saFadeUp 0.75s 0.25s ease both;
  }

  /* "assessment" — large, bold, white */
  .sa-heading__line--2 {
    font-size: clamp(4.2rem, 10vw, 9.5rem);
    font-weight: 600;
    font-style: normal;
    color: #fff;
    /* subtle gradient shimmer */
    background: linear-gradient(
      135deg,
      #fff 0%,
      var(--gold-light, #e8c47a) 45%,
      #fff 70%,
      rgba(255, 255, 255, 0.7) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: saFadeUp 0.8s 0.38s ease both;
  }

  /* ══════════════════════════
     RULE
  ══════════════════════════ */
  .sa-rule {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: saFadeUp 0.7s 0.55s ease both;
  }
  .sa-rule__line {
    width: 80px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201, 151, 58, 0.4));
  }
  .sa-rule__line--rev {
    background: linear-gradient(90deg, rgba(201, 151, 58, 0.4), transparent);
  }
  .sa-rule__glyph {
    font-size: 0.45rem;
    color: var(--gold, #c9973a);
    opacity: 0.6;
    letter-spacing: 0;
  }

  /* ══════════════════════════
     DESCRIPTOR
  ══════════════════════════ */
  .sa-descriptor {
    font-size: clamp(0.88rem, 1.4vw, 1.05rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--muted, #7a8fa6);
    opacity: 0;
    animation: saFadeUp 0.7s 0.68s ease both;
  }
  .sa-descriptor em {
    font-style: italic;
    color: var(--text-muted-light, #dae1ed);
  }

  /* ══════════════════════════
     BOTTOM FADE
  ══════════════════════════ */
  .sa-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--bg-primary, #0b1120)
    );
    z-index: 2;
    pointer-events: none;
  }

  /* ══════════════════════════
     ANIMATION
  ══════════════════════════ */
  @keyframes saFadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ══════════════════════════
     RESPONSIVE
  ══════════════════════════ */
  @media (max-width: 480px) {
    .sa-rule__line {
      width: 50px;
    }
    .sa-hero {
      min-height: 300px;
    }
  }
</style>

<script>
  // Re-trigger animations on Astro view transitions
  function initSaHero() {
    // Force reflow so CSS animations replay after VT swap
    const inner = document.querySelector(".sa-inner");
    if (!inner) return;
    inner
      .querySelectorAll<HTMLElement>(
        ".sa-eyebrow, .sa-heading__line, .sa-rule, .sa-descriptor",
      )
      .forEach((el) => {
        el.style.animation = "none";
        // eslint-disable-next-line @typescript-eslint/no-unused-expressions
        el.offsetHeight; // trigger reflow
        el.style.animation = "";
      });
  }

  document.addEventListener("astro:page-load", initSaHero);
</script>
