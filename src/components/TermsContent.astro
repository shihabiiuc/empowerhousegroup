<style>
  /* ─── Reset & Base ─────────────────────────────────────────────────── */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg-primary);
    color: var(--text);
    font-family: var(--font-body);
    font-weight: 300;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }

  /* ─── Hero ─────────────────────────────────────────────────────────── */
  .tou-hero {
    background: var(--bg-header);
    padding: 100px 32px 80px;
    text-align: center;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .tou-hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(201, 151, 58, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 151, 58, 0.035) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: radial-gradient(
      ellipse 70% 90% at 50% 50%,
      black 20%,
      transparent 100%
    );
  }

  .tou-hero-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 700px;
    height: 300px;
    background: radial-gradient(
      ellipse,
      rgba(201, 151, 58, 0.07) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  .tou-hero::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(201, 151, 58, 0.3),
      transparent
    );
  }

  .tou-hero-inner {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
  }

  .tou-eyebrow {
    display: inline-block;
    font-family: var(--navlinks);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.8;
    margin-bottom: 24px;
  }

  .tou-hero-heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(40px, 7vw, 72px);
    line-height: 1.05;
    color: var(--cream);
    margin-bottom: 20px;
    letter-spacing: -0.01em;
  }

  .tou-hero-heading em {
    font-style: italic;
    color: var(--gold-light);
  }

  .tou-hero-sub {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto 32px;
  }

  .tou-hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .tou-meta-line {
    display: block;
    width: 32px;
    height: 1px;
    background: var(--gold);
    opacity: 0.3;
  }
  .tou-meta-text {
    font-family: var(--navlinks);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0.6;
  }

  /* ─── Main Layout ──────────────────────────────────────────────────── */
  .tou-main {
    padding: 72px 24px 100px;
  }

  .tou-container {
    max-width: 840px;
    margin: 0 auto;
  }

  /* ─── Intro block ──────────────────────────────────────────────────── */
  .tou-intro {
    padding: 0 0 52px;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tou-intro p {
    font-size: 15px;
    color: var(--text-muted-light, #dae1ed);
    line-height: 1.8;
  }

  /* ─── Sections ─────────────────────────────────────────────────────── */
  .tou-section {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 0 28px;
    padding: 44px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .tou-section:last-child {
    border-bottom: none;
  }

  .tou-section-label {
    font-family: var(--navlinks);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--gold);
    opacity: 0.4;
    padding-top: 6px;
    text-align: right;
    line-height: 1;
  }

  .tou-section-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tou-section-heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(18px, 2.4vw, 24px);
    color: var(--cream);
    margin-bottom: 4px;
    line-height: 1.2;
  }

  .tou-section-body p {
    font-size: 14.5px;
    color: var(--text-muted);
    line-height: 1.85;
  }

  .tou-section-body p strong {
    color: var(--text);
    font-weight: 500;
  }

  /* ─── List ─────────────────────────────────────────────────────────── */
  .tou-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tou-list li {
    font-size: 14.5px;
    color: var(--text-muted);
    line-height: 1.75;
    padding-left: 20px;
    position: relative;
  }

  .tou-list li::before {
    content: "";
